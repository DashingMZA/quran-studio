VITE_PIXABAY_API_KEY=your_pixabay_api_key_here


# ── Tauri desktop signing ──────────────────────────────────────────────
# IMPORTANT: the Tauri CLI does NOT read .env files. These two MUST be real
# OS environment variables in the shell that runs `pnpm app:build`
# (PowerShell: $env:TAURI_SIGNING_PRIVATE_KEY="C:/path/to/quran-studio.key").
# Tauri accepts either the key FILE PATH or the raw key CONTENT.
# (GitHub Actions reads them from repository Secrets instead.)
# TAURI_SIGNING_PRIVATE_KEY=C:/path/to/your/quran-studio.key
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=   (only if you set one at generation)